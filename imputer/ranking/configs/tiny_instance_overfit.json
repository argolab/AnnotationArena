{
  "data_config": {
    "num_instances": 1,
    "train_test_split": 0.7,
    "K": 3,
    "I": 1,
    "J": 1,
    "C": 5,
    "D": 16,
    "sigma_annotator": 0.0001,
    "sigma_measurement": 0.0001,
    "alpha_dirichlet": 1.0,
    "temperature": 0.3,
    "sigma_embedding_prior": 1.0,
    "sigma_preference_prior": 1.0,
    "max_pairs_per_tied_group": 5,
    "min_group_size": 2,
    "max_group_size": 10,  // Changed from 3 to 10 to have full observations
    "rankings_per_annotator_attribute": 30
  },
  "model_config": {
    "encoder_layers": 2,
    "attention_heads": 4,
    "embedding_dim": 16,
    "dropout": 0.1,
    "embedding_type": "pairwise",
    "max_rank_size": 2,
    "masked_loss_weight": 1.0,
    "observed_loss_weight": 1.0
  },
  "pretraining_config": {
    "strategy": "sequential",
    "total_batches": 50,
    "batch_size": 8,
    "learning_rate": 1e-3,
    "train_heldout_split": 0.8,
    "eval_frequency": 10,
    "masking_rates": [0.3, 0.5, 0.7]
  },
  "finetuning_config": {
    "finetuning_steps": 20,
    "batch_size": 8,
    "learning_rate": 5e-4,
    "train_heldout_split": 0.8,
    "eval_frequency": 5,
    "test_masking_rate": 0.5,
    "masking_rates": [0.3, 0.5, 0.7]
  },
  "domain_config": {
    "chains": 1,
    "iter_warmup": 200,
    "iter_sampling": 1000,
    "adapt_delta": 0.8,
    "max_treedepth": 10,
    "sample_counts": [100, 200, 500, 1000],
    "use_oracle_checkpoint": false,
    "oracle_noise_scale": 0.01,
    "test_masking_rate": 0.5
  },
  "evaluation_config": {
    "test_masking_rate": 0.5,
    "eval_on_test_during_finetuning": true,
    "test_eval_frequency": 10
  },
  "enabled_strategies": [
    "Domain_Model"
  ],
  "output_dir": "experiment_results",
  "save_models": true,
  "save_training_histories": true,
  "log_wall_times": true,
  "experiment_name": "tiny_instance_overfit",
  "random_seed": 42,
  "device": "cpu"
